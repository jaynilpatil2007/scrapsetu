generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String     @id @default(cuid())
  clerkId     String     @unique
  email       String     @unique
  name        String?
  role        UserRole   @default(COLLECTOR)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  collectorId String?
  collector   Collector?
}

model Collector {
  id                String        @id @default(cuid())
  preferredLanguage Language      @default(HI)
  operatingArea     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lots              Lot[]
  transactions      Transaction[]
}

model Material {
  id                String             @id @default(cuid())
  category          String
  subcategory       String?
  description       String?
  unit              String             @default("kg")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lots              Lot[]
  prices            PriceRecord[]
  recyclerMaterials RecyclerMaterial[]

  @@index([category])
  @@index([subcategory])
}

model Lot {
  id                   String              @id @default(cuid())
  lotNumber            String              @unique
  collectorId          String
  materialId           String
  description          String?
  approxWeight         Float
  condition            String?
  sourceType           String?
  aiCategory           String?
  aiSubcategory        String?
  aiConfidence         Float?
  aiModel              String?
  confirmedCategory    String?
  confirmedSubcategory String?
  estimatedMinValue    Float?
  estimatedMaxValue    Float?
  collectionLatitude   Float?
  collectionLongitude  Float?
  collectionLocation   String?
  status               LotStatus           @default(DRAFT)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  handover             Handover?
  collector            Collector           @relation(fields: [collectorId], references: [id])
  material             Material            @relation(fields: [materialId], references: [id])
  images               LotImage[]
  quotes               PriceQuote[]
  events               TraceabilityEvent[]
  transaction          Transaction?

  @@index([collectorId])
  @@index([materialId])
  @@index([status])
  @@index([createdAt])
}

model LotImage {
  id        String   @id @default(cuid())
  url       String
  lotId     String
  createdAt DateTime @default(now())
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
}

model Recycler {
  id                  String              @id @default(cuid())
  name                String
  facilityLatitude    Float?
  facilityLongitude   Float?
  address             String?
  city                String?
  state               String?
  authorizationNumber String?
  authorizationStatus AuthorizationStatus @default(PENDING)
  authorizationExpiry DateTime?
  phone               String?
  email               String?
  pickupAvailable     Boolean             @default(false)
  serviceRadiusKm     Float?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  handovers           Handover[]
  quotes              PriceQuote[]
  prices              PriceRecord[]
  materials           RecyclerMaterial[]
  transactions        Transaction[]

  @@index([city])
  @@index([state])
  @@index([authorizationStatus])
}

model RecyclerMaterial {
  id              String   @id @default(cuid())
  recyclerId      String
  materialId      String
  offeredRate     Float
  unit            String   @default("kg")
  minQuantity     Float?
  pickupAvailable Boolean  @default(false)
  material        Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  recycler        Recycler @relation(fields: [recyclerId], references: [id], onDelete: Cascade)

  @@unique([recyclerId, materialId])
  @@index([materialId])
}

model PriceRecord {
  id           String      @id @default(cuid())
  materialId   String
  recyclerId   String?
  location     String?
  city         String?
  state        String?
  buyingPrice  Float
  sellingPrice Float?
  unit         String      @default("kg")
  sourceType   PriceSource
  recordedAt   DateTime    @default(now())
  material     Material    @relation(fields: [materialId], references: [id])
  recycler     Recycler?   @relation(fields: [recyclerId], references: [id])

  @@index([materialId, recordedAt])
  @@index([city, materialId])
}

model PriceQuote {
  id          String    @id @default(cuid())
  lotId       String
  recyclerId  String
  quotedPrice Float
  quotedTotal Float?
  expiresAt   DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  lot         Lot       @relation(fields: [lotId], references: [id])
  recycler    Recycler  @relation(fields: [recyclerId], references: [id])

  @@index([lotId])
  @@index([recyclerId])
}

model Transaction {
  id                 String        @id @default(cuid())
  transactionNumber  String        @unique
  lotId              String        @unique
  collectorId        String
  recyclerId         String
  quotedPrice        Float?
  finalPrice         Float
  quotedWeight       Float?
  finalWeight        Float?
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  collectionLocation String?
  handoverLocation   String?
  completedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  handovers          Handover?
  payout             Payout?
  collector          Collector     @relation(fields: [collectorId], references: [id])
  lot                Lot           @relation(fields: [lotId], references: [id])
  recycler           Recycler      @relation(fields: [recyclerId], references: [id])

  @@index([collectorId])
  @@index([recyclerId])
  @@index([paymentStatus])
}

model Payout {
  id               String        @id @default(cuid())
  transactionId    String        @unique
  amount           Float
  method           PaymentMethod
  provider         String?
  providerPayoutId String?
  destinationType  String?
  destinationRef   String?
  status           PayoutStatus  @default(CREATED)
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transaction      Transaction   @relation(fields: [transactionId], references: [id])

  @@index([status])
}

model Handover {
  id                   String      @id @default(cuid())
  lotId                String      @unique
  transactionId        String      @unique
  recyclerId           String
  weight               Float
  latitude             Float?
  longitude            Float?
  photoUrl             String?
  handoverReference    String      @unique
  verificationHash     String
  collectorConfirmedAt DateTime?
  recyclerConfirmedAt  DateTime?
  createdAt            DateTime    @default(now())
  lot                  Lot         @relation(fields: [lotId], references: [id])
  recycler             Recycler    @relation(fields: [recyclerId], references: [id])
  transaction          Transaction @relation(fields: [transactionId], references: [id])

  @@index([recyclerId])
}

model TraceabilityEvent {
  id           String   @id @default(cuid())
  lotId        String
  eventType    String
  actorType    String
  actorId      String?
  latitude     Float?
  longitude    Float?
  metadata     Json?
  previousHash String?
  eventHash    String
  createdAt    DateTime @default(now())
  lot          Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId, createdAt])
  @@index([eventType])
}

enum Language {
  HI
  MR
  EN
}

enum LotStatus {
  DRAFT
  READY
  MATCHING
  PICKUP_REQUESTED
  HANDED_OVER
  COMPLETED
  CANCELLED
}

enum AuthorizationStatus {
  PENDING
  VERIFIED
  EXPIRED
  SUSPENDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
}

enum PayoutStatus {
  CREATED
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PriceSource {
  RECYCLER_QUOTE
  COMPLETED_TRANSACTION
  ADMIN_ENTRY
  FIELD_RESEARCH
}

enum UserRole {
  COLLECTOR
  RECYCLER
  ADMIN
}
